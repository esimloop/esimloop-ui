---
interface Props {
  label: string;
  name: string;
  value: string;
  id?: string;
  checked?: boolean;
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { label, name, value, id, checked = false, disabled = false, class: cls = "", ...rest } = Astro.props;
---
<label class={["ds-check-row", cls].filter(Boolean).join(" ")}>
  <input class="ds-radio" type="radio" id={id} name={name} value={value} checked={checked} disabled={disabled} {...rest} />
  {label}
</label>
