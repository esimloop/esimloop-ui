---
import type { IconName } from "./icons";

interface Props {
  name: IconName;
  size?: "xs" | "sm" | "md" | "lg" | "xl";
  class?: string;
  /** Set only when the icon carries meaning on its own. */
  label?: string;
}

const { name, size = "md", class: cls = "", label } = Astro.props;
const classes = ["ds-icon", size !== "md" && "ds-icon--" + size, cls].filter(Boolean).join(" ");
---
<svg
  class={classes}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
><use href={"#i-" + name} /></svg>
