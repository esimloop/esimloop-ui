</style>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-set]");
  const sync = () => {
    const explicit = root.getAttribute("data-theme");
    const dark = explicit === "dark" || (!explicit && matchMedia("(prefers-color-scheme: dark)").matches);
    buttons.forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.themeSet === (dark ? "dark" : "light"))),
    );
  };
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      root.setAttribute("data-theme", b.dataset.themeSet!);
      sync();
    }),
  );
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", sync);
  sync();

  const ind = document.getElementById("r-ind") as HTMLInputElement | null;
  if (ind) ind.indeterminate = true;
</script>
