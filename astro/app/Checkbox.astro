---
/**
 * A labelled checkbox. The whole row is the target, so the label is part of the
 * hit area rather than decoration beside it.
 */
interface Props {
  label: string;
  id?: string;
  name?: string;
  value?: string;
  checked?: boolean;
  indeterminate?: boolean;
  disabled?: boolean;
  size?: "xs" | "md";
  class?: string;
  [key: string]: unknown;
}
const {
  label, id, name, value, checked = false, indeterminate = false,
  disabled = false, size = "md", class: cls = "", ...rest
} = Astro.props;
---
<label class={["ds-check-row", cls].filter(Boolean).join(" ")}>
  <input
    class={["ds-checkbox", size === "xs" && "ds-checkbox--xs"].filter(Boolean).join(" ")}
    type="checkbox"
    id={id} name={name} value={value}
    checked={checked} disabled={disabled}
    data-indeterminate={indeterminate ? "" : undefined}
    {...rest}
  />
  {label}
</label>

<script>
  // `indeterminate` is a property, not an attribute, so it cannot be rendered.
  document
    .querySelectorAll<HTMLInputElement>('input[type="checkbox"][data-indeterminate]')
    .forEach((el) => (el.indeterminate = true));
</script>
