---
import Icon from "../app/Icon.astro";

/**
 * Stars plus the number. The number is not optional: stars alone are a shape
 * that has to be counted, and rounding hides the difference between 4.5 and 4.9.
 */
interface Props {
  value: number;
  max?: number;
  count?: number;
  class?: string;
}
const { value, max = 5, count, class: cls = "" } = Astro.props;
const filled = Math.round(value);
---
<div class={["mk-rating", cls].filter(Boolean).join(" ")}>
  <span class="mk-rating__stars" aria-hidden="true">
    {Array.from({ length: max }).map((_, i) => (
      <Icon name="star" size="sm" class={i < filled ? "" : ""} data-empty={i < filled ? undefined : ""} />
    ))}
  </span>
  <span class="mk-rating__value">{value.toFixed(1)}</span>
  {count !== undefined && <span class="mk-rating__count">({count.toLocaleString()})</span>}
  <span class="ds-sr-only">{value.toFixed(1)} out of {max}{count !== undefined && `, from ${count} reviews`}</span>
</div>
