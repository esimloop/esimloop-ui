---
/**
 * The one dark surface in the marketing layer. Three text tones plus the accent
 * for the prompt - use `mk-t-bright`, `mk-t-dim` and `mk-t-accent` inside.
 */
interface Props {
  label?: string;
  class?: string;
}
const { label = "terminal", class: cls = "" } = Astro.props;
---
<div class={["mk-terminal", cls].filter(Boolean).join(" ")}>
  <div class="mk-terminal__bar">
    <i class="mk-terminal__dot" /><i class="mk-terminal__dot" /><i class="mk-terminal__dot" />
    <span class="mk-terminal__label">{label}</span>
  </div>
  <pre><slot /></pre>
</div>
