{
  "name": "esimloop-ui",
  "version": "1.0.0",
  "description": "A two-layer design system starter kit: a data-dense application layer and an editorial marketing layer, with swappable themes and an Astro scaffold.",
  "type": "module",
  "license": "MIT",
  "files": [
    "css",
    "themes",
    "astro",
    "bin",
    "scripts",
    "docs"
  ],
  "exports": {
    "./css/*": "./css/*",
    "./themes/*": "./themes/*",
    "./astro/*": "./astro/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "esimloop-ui": "./bin/init.mjs",
    "eui": "./bin/init.mjs"
  },
  "scripts": {
    "check": "node scripts/check-tokens.mjs",
    "init": "node bin/init.mjs",
    "example": "node bin/init.mjs example --name example --theme blank --force",
    "example:install": "npm --prefix example install",
    "example:dev": "npm --prefix example run dev",
    "example:build": "npm --prefix example run build",
    "verify": "npm run check && npm run example && npm run example:install && npm run example:build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "astro",
    "starter-kit",
    "ui",
    "dashboard"
  ]
}
